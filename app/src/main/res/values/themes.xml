<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#5B3DF5</item>
        <item name="android:colorAccent">#5B3DF5</item>
        <item name="android:statusBarColor">#F6F5FB</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <style name="InterruptTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/interrupt_bg</item>
        <item name="android:statusBarColor">@color/interrupt_bg</item>
        <item name="android:navigationBarColor">@color/interrupt_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>
